        </mxCell>

        <mxCell id="port_label" value="&lt;i&gt;порты: 5000→80, 5001→443&lt;/i&gt;" style="text;html=1;fontSize=10;align=center;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="480" y="310" width="200" height="20" as="geometry"/>
