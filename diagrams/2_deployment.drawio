        <!-- ===== СВЯЗИ ===== -->
        <mxCell id="conn1" value="HTTP/REST&lt;br&gt;(JSON)" style="html=1;endArrow=block;endFill=1;fontSize=10;strokeWidth=2;" edge="1" source="flutter_comp" target="aspnet" parent="1">
