        <mxCell id="main_db" value="&lt;b&gt;kidbank&lt;/b&gt;&lt;br&gt;(основная БД)&lt;br&gt;Пользователи, счета,&lt;br&gt;транзакции, задания..." style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=8;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;" vertex="1" parent="1">
