        <!-- Swagger -->
        <mxCell id="swagger" value="Swagger UI&lt;br&gt;(Development)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="480" y="350" width="140" height="40" as="geometry"/>
        </mxCell>

        <!-- ===== УРОВЕНЬ ДАННЫХ ===== -->
