        <mxCell id="mediatr" value="&lt;b&gt;MediatR (CQRS)&lt;/b&gt;&lt;br&gt;Commands / Queries&lt;br&gt;+ FluentValidation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="665" y="125" width="155" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="efcore" value="&lt;b&gt;Entity Framework Core 8&lt;/b&gt;&lt;br&gt;+ Npgsql Provider&lt;br&gt;+ AES-GCM шифрование" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;" vertex="1" parent="1">
