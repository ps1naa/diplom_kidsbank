          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="conn3" value="TCP/6379" style="html=1;endArrow=block;endFill=1;fontSize=10;strokeWidth=2;" edge="1" source="api_container" target="redis_node" parent="1">
