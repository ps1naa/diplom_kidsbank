        </mxCell>

        <mxCell id="settings_db" value="&lt;b&gt;kidbank_settings&lt;/b&gt;&lt;br&gt;(БД настроек)&lt;br&gt;AppSettings" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=8;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;" vertex="1" parent="1">
