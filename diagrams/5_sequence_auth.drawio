        <!-- ===== СООБЩЕНИЯ ===== -->

        <!-- 1. Client → API: POST /auth/login -->
        <mxCell id="m1" value="POST /api/v1/auth/login&lt;br&gt;{email, password}" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=10;exitX=1;exitY=0;exitDx=0;exitDy=0;" edge="1" parent="1">
