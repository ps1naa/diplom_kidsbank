<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" type="device">
  <diagram id="flowchart" name="Блок-схема: Перевод между счетами">
    <mxGraphModel dx="1200" dy="1800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="900" pageHeight="1800" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- Начало -->
        <mxCell id="f_start" value="Начало" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontSize=12;fontStyle=1;arcSize=50;" vertex="1" parent="1">
          <mxGeometry x="280" y="20" width="200" height="50" as="geometry"/>
        </mxCell>

        <!-- Ввод данных -->
        <mxCell id="f_input" value="Получить запрос:&#xa;SourceAccountId,&#xa;DestAccountId, Amount" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;fillColor=none;strokeColor=#000000;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="230" y="100" width="300" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="f_load_src" value="Загрузить исходный&#xa;счёт из БД" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="270" y="200" width="220" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="f_src_found" value="Исходный счёт&#xa;найден?" style="rhombus;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="290" y="280" width="180" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="f_err1" value="Ошибка:&#xa;«Счёт не найден»" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontSize=10;arcSize=50;" vertex="1" parent="1">
          <mxGeometry x="580" y="290" width="150" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="f_load_dst" value="Загрузить целевой&#xa;счёт из БД" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="270" y="395" width="220" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="f_dst_found" value="Целевой счёт&#xa;найден?" style="rhombus;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="290" y="475" width="180" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="f_err2" value="Ошибка:&#xa;«Счёт не найден»" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontSize=10;arcSize=50;" vertex="1" parent="1">
          <mxGeometry x="580" y="485" width="150" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="f_same_family" value="Счета в одной&#xa;семье?" style="rhombus;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="290" y="590" width="180" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="f_err3" value="Ошибка:&#xa;«Доступ запрещён»" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontSize=10;arcSize=50;" vertex="1" parent="1">
          <mxGeometry x="580" y="600" width="150" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="f_is_kid" value="Пользователь —&#xa;ребёнок?" style="rhombus;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="290" y="710" width="180" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="f_own_savings" value="Перевод на свою&#xa;копилку?" style="rhombus;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="290" y="830" width="180" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="f_limit_ok" value="Лимит расходов&#xa;не превышен?" style="rhombus;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="290" y="950" width="180" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="f_err4" value="Ошибка:&#xa;«Лимит превышен»" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontSize=10;arcSize=50;" vertex="1" parent="1">
          <mxGeometry x="580" y="960" width="155" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="f_balance_ok" value="Достаточно&#xa;средств?" style="rhombus;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="290" y="1075" width="180" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="f_err5" value="Ошибка:&#xa;«Недостаточно средств»" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontSize=10;arcSize=50;" vertex="1" parent="1">
          <mxGeometry x="580" y="1085" width="160" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="f_transfer" value="LedgerService.Transfer:&#xa;списать с исходного,&#xa;зачислить на целевой" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="255" y="1195" width="250" height="65" as="geometry"/>
        </mxCell>

        <mxCell id="f_create_tx" value="Создать запись Transaction&#xa;(тип Transfer)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="260" y="1290" width="240" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="f_save" value="SaveChangesAsync()" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="280" y="1370" width="200" height="45" as="geometry"/>
        </mxCell>

        <mxCell id="f_end" value="Конец" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontSize=12;fontStyle=1;arcSize=50;" vertex="1" parent="1">
          <mxGeometry x="300" y="1450" width="160" height="45" as="geometry"/>
        </mxCell>

        <!-- ===== СТРЕЛКИ ===== -->
        <mxCell id="a1" edge="1" source="f_start" target="f_input" parent="1" style="endArrow=block;endFill=1;html=1;strokeColor=#000000;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a2" edge="1" source="f_input" target="f_load_src" parent="1" style="endArrow=block;endFill=1;html=1;strokeColor=#000000;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a3" edge="1" source="f_load_src" target="f_src_found" parent="1" style="endArrow=block;endFill=1;html=1;strokeColor=#000000;"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- src_found: Да → load_dst, Нет → err1 -->
        <mxCell id="a4y" value="Да" edge="1" source="f_src_found" target="f_load_dst" parent="1" style="endArrow=block;endFill=1;html=1;strokeColor=#000000;fontSize=10;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a4n" value="Нет" edge="1" source="f_src_found" target="f_err1" parent="1" style="endArrow=block;endFill=1;html=1;strokeColor=#000000;fontSize=10;"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="a5" edge="1" source="f_load_dst" target="f_dst_found" parent="1" style="endArrow=block;endFill=1;html=1;strokeColor=#000000;"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- dst_found: Да → same_family, Нет → err2 -->
        <mxCell id="a6y" value="Да" edge="1" source="f_dst_found" target="f_same_family" parent="1" style="endArrow=block;endFill=1;html=1;strokeColor=#000000;fontSize=10;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a6n" value="Нет" edge="1" source="f_dst_found" target="f_err2" parent="1" style="endArrow=block;endFill=1;html=1;strokeColor=#000000;fontSize=10;"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- same_family: Да → is_kid, Нет → err3 -->
        <mxCell id="a7y" value="Да" edge="1" source="f_same_family" target="f_is_kid" parent="1" style="endArrow=block;endFill=1;html=1;strokeColor=#000000;fontSize=10;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a7n" value="Нет" edge="1" source="f_same_family" target="f_err3" parent="1" style="endArrow=block;endFill=1;html=1;strokeColor=#000000;fontSize=10;"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- is_kid: Да → own_savings, Нет → balance_ok (обход лимитов) -->
        <mxCell id="a8y" value="Да" edge="1" source="f_is_kid" target="f_own_savings" parent="1" style="endArrow=block;endFill=1;html=1;strokeColor=#000000;fontSize=10;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a8n" value="Нет" edge="1" source="f_is_kid" target="f_balance_ok" parent="1" style="endArrow=block;endFill=1;html=1;strokeColor=#000000;fontSize=10;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="170" y="750"/><mxPoint x="170" y="1115"/></Array>
          </mxGeometry>
        </mxCell>

        <!-- own_savings: Да → balance_ok (skip limit), Нет → limit_ok -->
        <mxCell id="a9n" value="Нет" edge="1" source="f_own_savings" target="f_limit_ok" parent="1" style="endArrow=block;endFill=1;html=1;strokeColor=#000000;fontSize=10;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a9y" value="Да" edge="1" source="f_own_savings" target="f_balance_ok" parent="1" style="endArrow=block;endFill=1;html=1;strokeColor=#000000;fontSize=10;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="210" y="870"/><mxPoint x="210" y="1115"/></Array>
          </mxGeometry>
        </mxCell>

        <!-- limit_ok: Да → balance_ok, Нет → err4 -->
        <mxCell id="a10y" value="Да" edge="1" source="f_limit_ok" target="f_balance_ok" parent="1" style="endArrow=block;endFill=1;html=1;strokeColor=#000000;fontSize=10;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a10n" value="Нет" edge="1" source="f_limit_ok" target="f_err4" parent="1" style="endArrow=block;endFill=1;html=1;strokeColor=#000000;fontSize=10;"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- balance_ok: Да → transfer, Нет → err5 -->
        <mxCell id="a11y" value="Да" edge="1" source="f_balance_ok" target="f_transfer" parent="1" style="endArrow=block;endFill=1;html=1;strokeColor=#000000;fontSize=10;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a11n" value="Нет" edge="1" source="f_balance_ok" target="f_err5" parent="1" style="endArrow=block;endFill=1;html=1;strokeColor=#000000;fontSize=10;"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="a12" edge="1" source="f_transfer" target="f_create_tx" parent="1" style="endArrow=block;endFill=1;html=1;strokeColor=#000000;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a13" edge="1" source="f_create_tx" target="f_save" parent="1" style="endArrow=block;endFill=1;html=1;strokeColor=#000000;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a14" edge="1" source="f_save" target="f_end" parent="1" style="endArrow=block;endFill=1;html=1;strokeColor=#000000;"><mxGeometry relative="1" as="geometry"/></mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
